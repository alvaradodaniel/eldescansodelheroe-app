rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /events/{eventId} {
      allow get, list: if resource.data.status == 'published';
      allow create, update, delete: if false;

      match /tables/{tableId} {
        allow get, list: if get(/databases/$(database)/documents/events/$(eventId)).data.status == 'published';
        allow create, update, delete: if false;
      }

      match /reservations/{uid} {
        allow get, list: if signedIn() && request.auth.uid == uid;
        allow create, update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
