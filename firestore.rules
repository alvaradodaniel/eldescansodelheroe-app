rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /events/{eventId} {
      allow get, list: if isAdmin() || resource.data.status in ['published', 'cancelled'];
      allow create, update, delete: if false;

      match /tables/{tableId} {
        allow get, list: if isAdmin() || get(/databases/$(database)/documents/events/$(eventId)).data.status in ['published', 'cancelled'];
        allow create, update, delete: if false;
      }

      match /reservations/{uid} {
        allow get, list: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create, update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
